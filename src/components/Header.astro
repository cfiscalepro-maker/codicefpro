---
import { pagePath, localeMeta, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { guideList } from '../i18n/alternates';
interface Props { locale: Locale; links: { locale: Locale; label: string; hreflang: string; href: string }[] }
const { locale, links: langs } = Astro.props;
const t = ui[locale].nav;
const nav = [
  { href: pagePath(locale, 'home'), label: t.calc },
  { href: pagePath(locale, 'inverse'), label: t.inverse },
  { href: pagePath(locale, 'verify'), label: t.verify },
  ...(guideList(locale).length ? [{ href: pagePath(locale, 'guides'), label: t.guides }] : []),
];
const current = localeMeta[locale];
---
<header class="border-b border-hairline bg-canvas">
  <div class="mx-auto flex max-w-page items-center justify-between gap-2 px-4 py-3 sm:px-6">
    <a href={pagePath(locale, 'home')} class="font-semibold tracking-tight text-ink">Codice Fiscale Pro</a>
    <nav aria-label={t.main} class="hidden items-center gap-1 md:flex">
      {nav.map((l) => <a href={l.href} class="rounded-full px-3 py-2 text-sm hover:text-ink">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <details class="relative">
        <summary aria-label={`${t.langAria}: ${current.label}`} class="flex h-10 cursor-pointer list-none items-center rounded-sm border border-hairline bg-elevated px-3 text-sm font-medium uppercase text-ink">{locale}</summary>
        <ul class="absolute right-0 z-20 mt-2 w-52 rounded-md border border-hairline bg-elevated p-2 shadow-lg">
          {langs.map((l) => (
            <li><a href={l.href} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.locale === locale ? 'true' : undefined} class={`block rounded-sm px-3 py-3 ${l.locale === locale ? 'font-semibold text-ink' : ''}`}>{l.label}</a></li>
          ))}
        </ul>
      </details>
      <button id="theme-toggle" type="button" class="flex h-10 w-10 items-center justify-center rounded-sm border border-hairline bg-elevated text-ink" aria-label={t.themeAria} title={t.theme}>
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <details class="relative md:hidden">
        <summary class="flex h-10 cursor-pointer list-none items-center rounded-sm border border-hairline bg-elevated px-3 text-sm font-medium text-ink">{t.menu}</summary>
        <nav aria-label={t.mainMobile} class="absolute right-0 z-20 mt-2 w-56 rounded-md border border-hairline bg-elevated p-2 shadow-lg">
          {nav.map((l) => <a href={l.href} class="block rounded-sm px-3 py-3 text-ink">{l.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const sync = () => {
    const dark = root.classList.contains('dark');
    const btn = document.getElementById('theme-toggle');
    btn?.setAttribute('aria-pressed', String(dark));
    meta?.setAttribute('content', dark ? '#0a0a0a' : '#fafafa');
  };
  sync();
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    sync();
  });
</script>
