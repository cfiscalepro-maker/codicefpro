---
// Body copy and visible FAQ under the calculator on the home page. The FAQ data also feeds the FAQPage schema.
import { homeExtra, homeFaq } from '../content/home';
import { resolveLinks } from '../i18n/alternates';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n/config';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="legal mx-auto max-w-3xl px-6 pb-8 pt-12">
  <Fragment set:html={resolveLinks(homeExtra[locale], locale)} />
  <h2>{ui[locale].guide.faq}</h2>
  {homeFaq[locale].map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
</section>
