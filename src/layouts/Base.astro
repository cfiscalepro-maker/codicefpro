---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Schema from '../components/seo/Schema.astro';
import { buildPageGraph, type Faq } from '../lib/seo/schema';
import { ui } from '../i18n/ui';
import { localeMeta, SITE } from '../i18n/config';
import { alternatesFor, selectorLinks, localeOf } from '../i18n/alternates';
interface Props { title: string; description: string; path: string; headline?: string; faq?: Faq[]; ogType?: 'website' | 'article'; published?: string; modified?: string; noindex?: boolean; }
const { title, description, path, headline, faq, ogType = 'website', published, modified, noindex = false } = Astro.props;
const locale = localeOf(path);
const t = ui[locale];
const lm = localeMeta[locale];
const base = SITE;
// Search results cut titles at about 60 characters. Past that, drop the brand suffix (the WebSite schema still names the site).
const pageTitle = title.length > 60 ? title.replace(/ \| Codice Fiscale Pro$/, '') : title;
const canonical = base + path;
const alternates = noindex ? [] : alternatesFor(path);
const links = selectorLinks(path);
const graph = buildPageGraph({ path, title, description, noindex, headline, published, modified, faq });
---
<!doctype html>
<html lang={lm.htmlLang} class="antialiased">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta property="og:type" content={ogType} />
  <meta name="author" content="Codice Fiscale Pro Team" />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  {graph && <Schema graph={graph} />}
  <meta property="og:site_name" content="Codice Fiscale Pro" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lm.og} />
  {alternates.filter((a) => a.hreflang !== 'x-default' && a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={localeMeta[a.locale].og} />)}
  <meta property="og:image" content={base + '/og-default.png'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Codice Fiscale Pro" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={base + '/og-default.png'} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#fafafa" />
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-screen bg-canvas text-body">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-sm focus:bg-ink focus:px-3 focus:py-2 focus:text-on-primary">{t.skip}</a>
  <Header locale={locale} links={links} />
  <main id="main"><slot /></main>
  <Footer locale={locale} links={links} />
  <CookieConsent locale={locale} />
</body>
</html>
